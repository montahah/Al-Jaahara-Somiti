    function filterCarsTable() {
      const q = document.getElementById('search-car-input').value.toLowerCase();
      const status = document.getElementById('filter-car-status').value;

      const filtered = carsData.filter(car => {
        const matchQ = car.plate.toLowerCase().includes(q) ||
                       car.model.toLowerCase().includes(q) ||
                       car.chassis.toLowerCase().includes(q);
        const matchStatus = status === 'ALL' || car.status === status;
        return matchQ && matchStatus;
      });

      renderInventoryCars(filtered);
    }

