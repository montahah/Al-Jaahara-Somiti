    function getStatusBadge(status) {
      if (status === 'IN_STOCK') {
        return `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">ইন (স্টকে)</span>`;
      } else if (status === 'SOLD_CASH') {
        return `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">আউট (ক্যাশ)</span>`;
      } else if (status === 'SOLD_INSTALLMENT') {
        return `<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">কিস্তিতে</span>`;
      }
      return status;
    }

    // গাড়ির ইনভেন্টরি পেজ রেন্ডার
