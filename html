          <td class="p-3 font-mono">${car.sellPrice > 0 ? formatKWD(car.sellPrice) : '-'}</td>
          <td class="p-3 font-mono font-bold ${netProfit >= 0 ? 'text-emerald-600' : 'text-rose-600'}">
            ${car.status === 'IN_STOCK' ? '-' : (netProfit >= 0 ? '+' : '') + formatKWD(netProfit)}
