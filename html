      };
      document.getElementById('page-heading').innerText = titles[tabId] || 'আল জাহরা প্রবাসী বন্ধন সমিতি';

      closeMobileDrawer();

      if (tabId === 'dashboard') {
        setTimeout(initCharts, 100);
      }
    }

    // ড্যাশবোর্ড আপডেট ও রেন্ডার
    function updateDashboardKPIs() {
      const totalCapital = investorsData.reduce((acc, inv) => acc + inv.capital, 0);
      document.getElementById('stat-investor-capital').innerText = formatKWD(totalCapital);
      document.getElementById('stat-investor-count').innerText = `${investorsData.length} জন অংশীদার মালিক`;

      const inStock = carsData.filter(c => c.status === 'IN_STOCK').length;
      const soldOut = carsData.filter(c => c.status !== 'IN_STOCK').length;
      document.getElementById('stat-in-stock-count').innerText = `${inStock} টি স্টকে (ইন)`;
      document.getElementById('stat-sold-out-count').innerText = `${soldOut} টি বিক্রি হইছে (আউট)`;

      let currentMonthPaid = 0;
      let totalDue = 0;
      carsData.filter(c => c.status === 'SOLD_INSTALLMENT').forEach(c => {
        currentMonthPaid += (c.monthlyInst || 0);
        totalDue += (c.remainingDue || 0);
      });
      document.getElementById('stat-month-collection').innerText = formatKWD(currentMonthPaid);
      document.getElementById('stat-total-due-balance').innerText = `বকেয়া: ${formatKWD(totalDue)}`;

      let totalProfit = 0;
      carsData.forEach(c => {
        if (c.status !== 'IN_STOCK') {
          totalProfit += (c.sellPrice - (c.buyPrice + c.repairCost));
        }
      });
      const profitEl = document.getElementById('stat-total-profit');
      profitEl.innerText = `${totalProfit >= 0 ? '+' : ''}${formatKWD(totalProfit)}`;
      profitEl.className = `text-base sm:text-xl lg:text-2xl font-black mt-1 tabular-nums ${totalProfit >= 0 ? 'text-emerald-600' : 'text-rose-600'}`;

      const stockRatioEl = document.getElementById('stock-ratio-text');
      if (stockRatioEl) {
        stockRatioEl.innerText = `মোট: ${carsData.length} টি | শোরুমে: ${inStock} | বিক্রিত: ${soldOut}`;
      }

      renderRecentCars();
    }

    // রিসেন্ট কার (মোবাইল কার্ড + ডেস্কটপ টেবিল)
