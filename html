          <td class="p-3 font-mono font-bold">${formatKWD(car.sellPrice)}</td>
          <td class="p-3 font-mono">${formatKWD(car.downPayment)}</td>
          <td class="p-3 font-mono font-bold text-indigo-700">${formatKWD(car.monthlyInst)}</td>
          <td class="p-3 font-mono text-emerald-600 font-bold">${formatKWD(car.paidAmount)}</td>
          <td class="p-3 font-mono text-rose-600 font-bold">${formatKWD(car.remainingDue)}</td>
          <td class="p-3">
            ${isPaidOff ? 
              `<span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold">পরিশোধ</span>` : 
              `<span class="px-2 py-0.5 bg-amber-100 text-amber-800 rounded text-[10px] font-bold">চলমান</span>`}
          </td>
          <td class="p-3 text-right">
            ${!isPaidOff ? `
              <button onclick="openCollectModal(${car.id})" class="px-2.5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-bold shadow-sm transition">
                আদায়
              </button>
            ` : `
              <button onclick="viewCompletedReceipt(${car.id})" class="px-2 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded text-xs font-semibold">
                রশিদ
              </button>
            `}
          </td>
        `;
        tbody.appendChild(tr);

        // মোবাইল কার্ড
        const card = document.createElement('div');
        card.className = 'bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm space-y-2 text-xs';
        card.innerHTML = `
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <div>
              <span class="font-mono font-bold text-indigo-600">${car.plate}</span>
              <span class="text-slate-700 font-bold ml-1.5">${car.customer}</span>
            </div>
            ${isPaidOff ? 
              `<span class="px-2 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold">পরিশোধ</span>` : 
              `<span class="px-2 py-0.5 bg-amber-100 text-amber-800 rounded text-[10px] font-bold">চলমান</span>`}
          </div>
          <div class="grid grid-cols-2 gap-2 text-[11px] bg-slate-50 p-2 rounded-lg">
            <div><span class="text-slate-500">মাসিক কিস্তি:</span> <strong class="font-mono">${formatKWD(car.monthlyInst)}</strong></div>
            <div><span class="text-slate-500">মোট টাকা উঠছে:</span> <strong class="font-mono text-emerald-600">${formatKWD(car.paidAmount)}</strong></div>
            <div class="col-span-2 pt-1 border-t border-slate-200/60 flex justify-between">
              <span class="text-rose-600 font-bold">বাকি ছিল:</span>
              <strong class="font-mono text-rose-600 font-bold">${formatKWD(car.remainingDue)}</strong>
            </div>
          </div>
          <div class="flex justify-end pt-1">
            ${!isPaidOff ? `
              <button onclick="openCollectModal(${car.id})" class="w-full py-2 bg-indigo-600 text-white rounded-lg text-xs font-bold text-center">
                কিস্তি গ্রহণ ও রশিদ তৈরি
              </button>
            ` : `
              <button onclick="viewCompletedReceipt(${car.id})" class="w-full py-1.5 bg-slate-100 text-slate-700 rounded-lg text-xs font-semibold text-center">
                রশিদ দেখুন
              </button>
            `}
          </div>
        `;
        cards.appendChild(card);
      });

      document.getElementById('inst-collected-total').innerText = formatKWD(totalCollected);
      document.getElementById('inst-remaining-total').innerText = formatKWD(totalDue);
    }

    // ইনভেস্টর হিসাব রেন্ডার
    function renderInvestorsSection() {
      const cardContainer = document.getElementById('investors-card-container');
      const tableBody = document.getElementById('investors-table-body');
      cardContainer.innerHTML = '';
      tableBody.innerHTML = '';

      let totalBusinessProfit = 0;
      carsData.forEach(c => {
        if (c.status !== 'IN_STOCK') {
          totalBusinessProfit += (c.sellPrice - (c.buyPrice + c.repairCost));
        }
      });

      investorsData.forEach(inv => {
        const profitShare = (totalBusinessProfit * inv.sharePct) / 100;
        const currentBalance = (inv.capital + profitShare) - inv.withdrawn;

        // কার্ড
        const card = document.createElement('div');
        card.className = 'bg-white p-4 rounded-xl sm:rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden';
        card.innerHTML = `
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <div>
              <h4 class="font-bold text-slate-900 text-xs sm:text-sm">${inv.name}</h4>
              <p class="text-[10px] text-slate-400 font-mono">${inv.phone}</p>
            </div>
            <span class="px-2 py-0.5 bg-indigo-50 text-indigo-700 rounded-lg text-[11px] font-bold">${inv.sharePct}% শেয়ার</span>
          </div>
          <div class="mt-3 space-y-1.5 text-[11px]">
            <div class="flex justify-between">
              <span class="text-slate-500">মূল ইনভেস্টমেন্ট:</span>
              <span class="font-bold font-mono text-slate-800">${formatKWD(inv.capital)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">অর্জিত মুনাফা (${inv.sharePct}%):</span>
              <span class="font-bold font-mono text-emerald-600">+${formatKWD(profitShare)}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-slate-500">টাকা উত্তোলন:</span>
              <span class="font-bold font-mono text-rose-500">-${formatKWD(inv.withdrawn)}</span>
            </div>
            <div class="pt-2 border-t border-slate-100 flex justify-between font-bold text-xs sm:text-sm">
              <span class="text-slate-800">মোট পাওনা:</span>
              <span class="font-mono text-indigo-600">${formatKWD(currentBalance)}</span>
            </div>
          </div>
        `;
        cardContainer.appendChild(card);

        // টেবিল রো
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 border-b border-slate-100';
        tr.innerHTML = `
          <td class="p-3 font-bold text-slate-800">${inv.name}</td>
          <td class="p-3 font-mono text-slate-500 text-[11px]">${inv.phone}</td>
          <td class="p-3 font-mono font-bold">${formatKWD(inv.capital)}</td>
          <td class="p-3 font-bold text-indigo-600">${inv.sharePct}%</td>
          <td class="p-3 font-mono text-emerald-600 font-bold">+${formatKWD(profitShare)}</td>
          <td class="p-3 font-mono text-rose-500 font-medium">-${formatKWD(inv.withdrawn)}</td>
          <td class="p-3 font-mono font-bold text-slate-900">${formatKWD(currentBalance)}</td>
        `;
        tableBody.appendChild(tr);
      });
    }

    // গাড়ির নাম্বারে ক্লিক করলে পপআপে সম্পূর্ণ ডিটেলস
    function showCarDetails(carId) {
      const car = carsData.find(c => c.id === carId);
      if (!car) return;

      document.getElementById('dossier-plate').innerText = `গাড়ির ইতিহাস: ${car.plate}`;
      document.getElementById('dossier-model').innerText = car.model;
      document.getElementById('dossier-chassis').innerText = car.chassis;
      document.getElementById('dossier-investor').innerText = car.investor;
      document.getElementById('dossier-dateIn').innerText = car.dateIn;
      document.getElementById('dossier-dateOut').innerText = car.dateOut || 'শোরুমে আছে';
      document.getElementById('dossier-saleType').innerText = car.saleType;

      document.getElementById('dossier-buyPrice').innerText = formatKWD(car.buyPrice);
      document.getElementById('dossier-repairCost').innerText = formatKWD(car.repairCost);
      document.getElementById('dossier-sellPrice').innerText = car.sellPrice > 0 ? formatKWD(car.sellPrice) : 'নির্ধারিত হয়নি';

      const profitBox = document.getElementById('dossier-profitBox');
      const profitText = document.getElementById('dossier-profit');
      const profitLabel = document.getElementById('dossier-profitLabel');

      if (car.status !== 'IN_STOCK') {
        const net = car.sellPrice - (car.buyPrice + car.repairCost);
        profitLabel.innerText = net >= 0 ? 'নিট লাভ (Profit):' : 'নিট ক্ষতি (Loss):';
        profitText.innerText = (net >= 0 ? '+' : '') + formatKWD(net);
        profitBox.className = `p-2.5 rounded-lg ${net >= 0 ? 'bg-emerald-50 text-emerald-800' : 'bg-rose-50 text-rose-800'}`;
      } else {
        profitLabel.innerText = 'লাভ/লোকসান:';
        profitText.innerText = 'স্টকে আছে';
        profitBox.className = 'p-2.5 bg-slate-100 text-slate-600 rounded-lg';
      }

      const instBox = document.getElementById('dossier-installment-box');
      if (car.status === 'SOLD_INSTALLMENT') {
        instBox.classList.remove('hidden');
        document.getElementById('dossier-customer').innerText = car.customer;
        document.getElementById('dossier-phone').innerText = car.phone;
        document.getElementById('dossier-monthlyInst').innerText = formatKWD(car.monthlyInst);
        document.getElementById('dossier-paidAmount').innerText = formatKWD(car.paidAmount);
        document.getElementById('dossier-remainingDue').innerText = formatKWD(car.remainingDue);
      } else {
        instBox.classList.add('hidden');
      }

      document.getElementById('carDetailsModal').classList.remove('hidden');
    }

    // কিস্তি আদায়
    function openCollectModal(carId) {
      const car = carsData.find(c => c.id === carId);
      if (!car) return;

      document.getElementById('pay-car-id').value = car.id;
      document.getElementById('pay-car-desc').value = `${car.plate} - ${car.customer}`;
      document.getElementById('pay-current-due').value = formatKWD(car.remainingDue);
      document.getElementById('pay-now-amount').value = car.monthlyInst;
      document.getElementById('pay-now-amount').max = car.remainingDue;

      document.getElementById('collectInstallmentModal').classList.remove('hidden');
    }

    function processInstallmentPayment(e) {
      e.preventDefault();
      const carId = parseInt(document.getElementById('pay-car-id').value);
      const paidNow = parseFloat(document.getElementById('pay-now-amount').value);
      const method = document.getElementById('pay-payment-method').value;

      const car = carsData.find(c => c.id === carId);
      if (!car) return;

      const prevDue = car.remainingDue;
      car.paidAmount += paidNow;
      car.remainingDue -= paidNow;
      if (car.remainingDue < 0) car.remainingDue = 0;

      closeModal('collectInstallmentModal');

      updateDashboardKPIs();
      renderInstallmentTable();
      renderInventoryCars();
      renderMonthlyReport();

      displayOfficialReceipt({
        car: car,
        paidNow: paidNow,
        prevDue: prevDue,
        currDue: car.remainingDue,
        method: method
      });
    }

    function viewCompletedReceipt(carId) {
      const car = carsData.find(c => c.id === carId);
      if (!car) return;
      displayOfficialReceipt({
        car: car,
        paidNow: car.monthlyInst,
        prevDue: 0,
        currDue: 0,
        method: "চূড়ান্ত নিষ্পত্তি (Paid in Full)"
      });
    }

    function displayOfficialReceipt(data) {
      const { car, paidNow, prevDue, currDue, method } = data;

      document.getElementById('rec-voucher-no').innerText = '#JB-' + Math.floor(100000 + Math.random() * 900000);
      document.getElementById('rec-date-text').innerText = new Date().toLocaleDateString('en-GB');
      document.getElementById('rec-method-text').innerText = method;

      document.getElementById('rec-customer-name').innerText = car.customer;
      document.getElementById('rec-customer-id').innerText = `সিভিল: ${car.civilId} | ফোন: ${car.phone}`;
      document.getElementById('rec-car-details').innerText = `${car.plate} (${car.model})`;

      document.getElementById('rec-amount-paid').innerText = formatKWD(paidNow);
      document.getElementById('rec-prev-due').innerText = formatKWD(prevDue);
      document.getElementById('rec-curr-due').innerText = formatKWD(currDue);

      document.getElementById('receiptModal').classList.remove('hidden');
    }

    // ব্ল্যাংক পেজ মুক্ত প্রিন্ট
    function printOfficialReceipt() {
      document.body.classList.remove('printing-report');
      document.body.classList.add('printing-receipt');

      setTimeout(() => {
        window.print();
        setTimeout(() => {
          document.body.classList.remove('printing-receipt');
        }, 800);
      }, 80);
    }

    // মাসিক রিপোর্ট
    function renderMonthlyReport() {
      const monthTitle = document.getElementById('report-month-filter').options[document.getElementById('report-month-filter').selectedIndex].text;

      document.getElementById('rep-selected-month-title').innerText = monthTitle;
      document.getElementById('rep-print-date').innerText = new Date().toLocaleDateString('en-GB');

      let totalSales = 0;
      let totalCosts = 0;
      let monthInstallment = 0;
      let netProfit = 0;

      const reportTbody = document.getElementById('rep-cars-breakdown');
      reportTbody.innerHTML = '';

      carsData.forEach(car => {
        if (car.status !== 'IN_STOCK') {
          const cost = car.buyPrice + car.repairCost;
          const profit = car.sellPrice - cost;

          totalSales += car.sellPrice;
          totalCosts += cost;
          netProfit += profit;

          if (car.status === 'SOLD_INSTALLMENT') {
            monthInstallment += car.monthlyInst;
          }

          const tr = document.createElement('tr');
          tr.className = 'border-b border-slate-100 text-xs';
          tr.innerHTML = `
            <td class="p-2.5 font-mono font-bold">${car.plate}</td>
            <td class="p-2.5">${car.model}</td>
            <td class="p-2.5 font-mono">${formatKWD(car.buyPrice)}</td>
            <td class="p-2.5 font-mono">${formatKWD(car.repairCost)}</td>
            <td class="p-2.5 font-mono font-bold">${formatKWD(car.sellPrice)}</td>
            <td class="p-2.5 font-mono font-bold text-right ${profit >= 0 ? 'text-emerald-700' : 'text-rose-700'}">
              ${profit >= 0 ? '+' : ''}${formatKWD(profit)}
            </td>
          `;
          reportTbody.appendChild(tr);
        }
      });

      document.getElementById('rep-total-sales').innerText = formatKWD(totalSales);
      document.getElementById('rep-total-costs').innerText = formatKWD(totalCosts);
      document.getElementById('rep-total-installments').innerText = formatKWD(monthInstallment);
      
      const netProfitEl = document.getElementById('rep-net-profit');
      netProfitEl.innerText = `${netProfit >= 0 ? '+' : ''}${formatKWD(netProfit)}`;
    }

    function printMonthlyStatementSheet() {
      document.body.classList.remove('printing-receipt');
      document.body.classList.add('printing-report');

      setTimeout(() => {
        window.print();
        setTimeout(() => {
          document.body.classList.remove('printing-report');
        }, 800);
      }, 80);
    }

    function quickPrintMonthlyReport() {
      switchTab('reports');
      setTimeout(printMonthlyStatementSheet, 150);
    }

    // মোডাল হেল্পার
    function openAddCarModal() {
      document.getElementById('addCarModal').classList.remove('hidden');
    }
    function openAddInvestorModal() {
      document.getElementById('addInvestorModal').classList.remove('hidden');
    }
    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
    }

    function handleSaveNewCar(e) {
      e.preventDefault();
      const plate = document.getElementById('input-car-plate').value;
      const model = document.getElementById('input-car-model').value;
      const chassis = document.getElementById('input-car-chassis').value || 'N/A';
      const investor = document.getElementById('input-car-investor').value;
      const buyPrice = parseFloat(document.getElementById('input-car-buyprice').value);
      const repairCost = parseFloat(document.getElementById('input-car-repaircost').value) || 0;
      const status = document.getElementById('input-car-status').value;

      const newCar = {
        id: carsData.length + 1,
        plate: plate,
        model: model,
        chassis: chassis,
        investor: investor,
        dateIn: new Date().toISOString().split('T')[0],
        dateOut: status === 'IN_STOCK' ? '-' : new Date().toISOString().split('T')[0],
        buyPrice: buyPrice,
        repairCost: repairCost,
        sellPrice: status === 'IN_STOCK' ? 0.000 : buyPrice + 1200.000,
        status: status,
        saleType: status === 'IN_STOCK' ? 'বিক্রি হয়নি (Stock)' : (status === 'SOLD_CASH' ? 'ক্যাশ বিক্রি' : 'কিস্তি বিক্রি'),
        customer: status !== 'IN_STOCK' ? 'কাস্টমার (কুয়েত)' : '-',
        phone: '-',
        civilId: '-',
        downPayment: 0.000,
        monthlyInst: 0.000,
        paidAmount: 0.000,
        remainingDue: 0.000
      };

      carsData.unshift(newCar);
      closeModal('addCarModal');
      document.getElementById('addCarForm').reset();

      updateDashboardKPIs();
      renderInventoryCars();
      renderInstallmentTable();
      renderInvestorsSection();
      renderMonthlyReport();
      initCharts();
    }

    function handleSaveNewInvestor(e) {
      e.preventDefault();
      const name = document.getElementById('inv-name-input').value;
      const phone = document.getElementById('inv-phone-input').value;
      const capital = parseFloat(document.getElementById('inv-capital-input').value);
      const sharePct = parseFloat(document.getElementById('inv-share-input').value);

      investorsData.push({
        name: name,
        phone: phone,
        capital: capital,
        sharePct: sharePct,
        withdrawn: 0.000
      });

      closeModal('addInvestorModal');
      document.getElementById('addInvestorForm').reset();

      updateDashboardKPIs();
      renderInvestorsSection();
    }

    // Chart.js গ্রাফ
    function initCharts() {
      const cashflowCtx = document.getElementById('cashflowChart');
      if (cashflowCtx) {
        if (cashflowChartInstance) cashflowChartInstance.destroy();
        cashflowChartInstance = new Chart(cashflowCtx, {
          type: 'line',
          data: {
            labels: ['মে', 'জুন', 'জুলাই', 'আগস্ট', 'সেপ্টেম্বর', 'অক্টোবর'],
            datasets: [
              {
                label: 'কিস্তি আদায় (KWD)',
                data: [1500, 2200, 1900, 3400, 4800, 5400],
                borderColor: '#4f46e5',
                backgroundColor: 'rgba(79, 70, 229, 0.08)',
                tension: 0.3,
                fill: true,
                borderWidth: 2.5
              },
              {
                label: 'গাড়ি ক্রয় (KWD)',
                data: [9000, 0, 15000, 9200, 13500, 6500],
                borderColor: '#ef4444',
                borderDash: [5, 4],
                tension: 0.3,
                borderWidth: 1.5
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'top',
                labels: { boxWidth: 12, font: { size: 10 } }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                ticks: {
                  callback: val => val + ' KWD',
                  font: { size: 9 }
                }
              },
              x: {
                ticks: { font: { size: 9 } }
              }
            }
          }
        });
      }

      const stockCtx = document.getElementById('stockDoughnutChart');
      if (stockCtx) {
        if (stockChartInstance) stockChartInstance.destroy();

        const inStock = carsData.filter(c => c.status === 'IN_STOCK').length;
        const soldCash = carsData.filter(c => c.status === 'SOLD_CASH').length;
        const soldInst = carsData.filter(c => c.status === 'SOLD_INSTALLMENT').length;

        stockChartInstance = new Chart(stockCtx, {
          type: 'doughnut',
          data: {
            labels: ['স্টকে আছে', 'ক্যাশ বিক্রি', 'কিস্তিতে বিক্রি'],
            datasets: [{
              data: [inStock, soldCash, soldInst],
              backgroundColor: ['#3b82f6', '#10b981', '#f59e0b'],
              borderWidth: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                position: 'bottom',
                labels: { boxWidth: 10, font: { size: 10 } }
              }
            }
          }
        });
      }
    }

    window.onload = function() {
      updateDashboardKPIs();
      renderInventoryCars();
      renderInstallmentTable();
      renderInvestorsSection();
      renderMonthlyReport();
      initCharts();
    };
  </script>
</body>
</html>
