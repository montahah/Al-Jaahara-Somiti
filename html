<!DOCTYPE html>
<html lang="bn" dir="ltr" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
  <meta name="theme-color" content="#0f172a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Al Jaahara Probashi Bandhan Samiti - Kuwait Car Dealership & Accounting</title>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Google Fonts: Inter and Hind Siliguri for Bengali -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Chart.js CDN for financial charts -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    tailwind.config = {
      theme: {
        screens: {
          'xs': '360px',
          'sm': '640px',
          'md': '768px',
          'lg': '1024px',
          'xl': '1280px',
          '2xl': '1536px',
        },
        extend: {
          fontFamily: {
            sans: ['Hind Siliguri', 'Inter', '-apple-system', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* Smooth touch scrolling and scrollbar customization */
    * {
      -webkit-tap-highlight-color: transparent;
      box-sizing: border-box;
    }
    
    body {
      overflow-x: hidden;
      width: 100%;
    }

    .touch-scroll {
      -webkit-overflow-scrolling: touch;
    }

    /* Custom thin scrollbar */
    ::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }

    /* ==========================================================================
       প্রিন্ট এরিয়ার বিশেষ সিএসএস (PRINT & SAVE AS PDF FIX FOR ALL DEVICES)
       ========================================================================== */
    @media print {
      html, body {
        height: auto !important;
        min-height: 100% !important;
        overflow: visible !important;
        background: #ffffff !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 0 !important;
        font-size: 11pt !important;
      }

      aside, header, #sidebar-drawer, #sidebar-backdrop, #bottom-mobile-nav, 
      .no-print, button, input, select, .action-buttons, #mobile-header {
        display: none !important;
        visibility: hidden !important;
      }

      main {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        display: block !important;
        overflow: visible !important;
      }

      body.printing-receipt #printable-receipt {
        display: block !important;
        visibility: visible !important;
        position: static !important;
        width: 100% !important;
        max-width: 580px !important;
        margin: 0 auto !important;
        padding: 16px !important;
        border: 2px solid #000 !important;
        box-shadow: none !important;
        page-break-inside: avoid;
      }

      body.printing-receipt *:not(#printable-receipt, #printable-receipt *) {
        display: none !important;
      }

      body.printing-report #monthly-printable-statement {
        display: block !important;
        visibility: visible !important;
        position: static !important;
        width: 100% !important;
        padding: 12px !important;
        margin: 0 !important;
        box-shadow: none !important;
        border: none !important;
      }

      body.printing-report *:not(#monthly-printable-statement, #monthly-printable-statement *) {
        display: none !important;
      }

      table, th, td {
        border-color: #475569 !important;
        color: #000000 !important;
      }
    }
  </style>
</head>

<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col lg:flex-row pb-16 lg:pb-0">

  <!-- ==========================================================================
       মোবাইল সাইডবার ব্যাকড্রপ (Mobile Drawer Backdrop)
       ========================================================================== -->
  <div id="sidebar-backdrop" onclick="closeMobileDrawer()" class="fixed inset-0 bg-slate-950/70 z-40 lg:hidden hidden backdrop-blur-sm transition-opacity duration-300"></div>

  <!-- ==========================================================================
       সাইডবার নেভিগেশন (Responsive Sidebar / Off-Canvas Drawer)
       ========================================================================== -->
  <aside id="main-sidebar" class="fixed inset-y-0 left-0 z-50 w-72 sm:w-80 lg:w-64 xl:w-72 bg-slate-900 text-slate-100 flex flex-col justify-between shadow-2xl transition-transform duration-300 ease-in-out -translate-x-full lg:translate-x-0 lg:static lg:h-screen lg:sticky lg:top-0">
    <div>
      <!-- হেডার লোগো এবং পরিচিতি -->
      <div class="p-4 sm:p-5 border-b border-slate-800 bg-slate-950/70 flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-tr from-amber-500 via-indigo-600 to-indigo-400 flex items-center justify-center text-white font-black text-xl shadow-lg shadow-indigo-900/50 flex-shrink-0">
            ج
          </div>
          <div class="min-w-0">
            <h1 class="text-xs sm:text-sm font-bold text-white tracking-tight leading-snug truncate">
              Al Jaahara Probashi
              <span class="block text-amber-400 text-[11px] font-semibold">Bandhan Samiti (الجهراء)</span>
            </h1>
            <p class="text-[10px] text-slate-400 mt-0.5 truncate">কুয়েত কার ডিলারশিপ ও একাউন্টিং</p>
          </div>
        </div>
        <!-- ড্রয়ার ক্লোজ বাটন (মোবাইল) -->
        <button onclick="closeMobileDrawer()" class="lg:hidden text-slate-400 hover:text-white p-2 rounded-lg" aria-label="Close menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- নেভিগেশন আইটেমস -->
      <nav class="p-3 sm:p-4 space-y-1 text-xs font-medium">
        <!-- ১. ড্যাশবোর্ড -->
        <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-item w-full flex items-center gap-3 px-3.5 py-3 rounded-xl transition text-white bg-indigo-600 shadow-md shadow-indigo-600/30">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
          <span class="text-left font-semibold">ড্যাশবোর্ড সমগ্র খতিয়ান</span>
        </button>

        <!-- ২. গাড়ি স্টক (ইন / আউট) -->
        <button onclick="switchTab('cars')" id="nav-cars" class="nav-item w-full flex items-center gap-3 px-3.5 py-3 rounded-xl transition text-slate-300 hover:text-white hover:bg-slate-800">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
          <span class="text-left">২. কত গাড়ি ঢুকছে ও বের হইছে (Stock)</span>
        </button>

        <!-- ৩. কিস্তি আদায় ও বাকি বিবরণ -->
        <button onclick="switchTab('installments')" id="nav-installments" class="nav-item w-full flex items-center gap-3 px-3.5 py-3 rounded-xl transition text-slate-300 hover:text-white hover:bg-slate-800">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span class="text-left">৩. কিস্তি হিসাব ও মাসিক আদায়</span>
        </button>

        <!-- ৪. ইনভেস্টর হিসাব (মালিক পক্ষ) -->
        <button onclick="switchTab('investors')" id="nav-investors" class="nav-item w-full flex items-center gap-3 px-3.5 py-3 rounded-xl transition text-slate-300 hover:text-white hover:bg-slate-800">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          <span class="text-left">১. মালিক পক্ষের ইনভেস্টর হিসাব</span>
        </button>

        <!-- ৫. প্রতি মাসের হিসাব ও প্রিন্ট -->
        <button onclick="switchTab('reports')" id="nav-reports" class="nav-item w-full flex items-center gap-3 px-3.5 py-3 rounded-xl transition text-slate-300 hover:text-white hover:bg-slate-800">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span class="text-left">৮. মাসিক হিসাব বিবরণী ও প্রিন্ট</span>
        </button>
      </nav>
    </div>

    <!-- কারেন্সি ব্যানার -->
    <div class="p-4 border-t border-slate-800 bg-slate-950/60 text-xs">
      <div class="flex items-center justify-between text-slate-400 mb-1">
        <span>মুদ্রা (Currency):</span>
        <span class="font-bold text-amber-400 bg-amber-950/60 border border-amber-500/30 px-2 py-0.5 rounded text-[11px]">KWD (د.ك)</span>
      </div>
      <p class="text-[11px] text-slate-500 truncate">আল জাহরা, কুয়েত সিটি</p>
    </div>
  </aside>

  <!-- ==========================================================================
       মোবাইল বটম বার (Bottom Quick Navigation for Smartphones)
       ========================================================================== -->
  <div id="bottom-mobile-nav" class="lg:hidden fixed bottom-0 inset-x-0 bg-slate-900/95 backdrop-blur-md border-t border-slate-800 z-30 flex items-center justify-around px-2 py-1 text-[10px] text-slate-400">
    <button onclick="switchTab('dashboard')" class="flex flex-col items-center py-1.5 px-2 hover:text-indigo-400 focus:text-indigo-400">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
      <span>ড্যাশবোর্ড</span>
    </button>
    <button onclick="switchTab('cars')" class="flex flex-col items-center py-1.5 px-2 hover:text-indigo-400 focus:text-indigo-400">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
      <span>গাড়ি স্টক</span>
    </button>
    <button onclick="openAddCarModal()" class="flex flex-col items-center -mt-4 bg-indigo-600 text-white rounded-full p-2.5 shadow-lg border-2 border-slate-900 focus:outline-none">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
    </button>
    <button onclick="switchTab('installments')" class="flex flex-col items-center py-1.5 px-2 hover:text-indigo-400 focus:text-indigo-400">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <span>কিস্তি</span>
    </button>
    <button onclick="switchTab('reports')" class="flex flex-col items-center py-1.5 px-2 hover:text-indigo-400 focus:text-indigo-400">
      <svg class="w-5 h-5 mb-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
      <span>প্রিন্ট</span>
    </button>
  </div>

  <main class="flex-1 flex flex-col min-w-0 w-full overflow-y-auto">
    
    <!-- মোবাইল ও ডেস্কটপ টপবার (Responsive Header) -->
    <header class="bg-white border-b border-slate-200 px-3 sm:px-6 py-2.5 sm:py-3.5 flex items-center justify-between sticky top-0 z-20 shadow-sm no-print">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <!-- মোবাইল মেনু হ্যামবার্গার বাটন -->
        <button onclick="openMobileDrawer()" class="lg:hidden p-2 rounded-xl text-slate-700 bg-slate-100 hover:bg-slate-200 transition focus:outline-none flex-shrink-0" aria-label="Open menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
        </button>
        
        <div class="min-w-0">
          <h2 id="page-heading" class="text-xs sm:text-base lg:text-lg font-bold text-slate-900 leading-tight truncate">
            আল জাহরা প্রবাসী বন্ধন সমিতি - ড্যাশবোর্ড
          </h2>
          <p class="text-[10px] sm:text-xs text-slate-500 hidden sm:block truncate">কুয়েতি দিনার (KWD) ভিত্তিক গাড়ির কেনাবেচা, ইনভেস্টর ও কিস্তি কালেকশন সিস্টেম</p>
        </div>
      </div>

      <!-- হেডার কুইক একশন বাটন -->
      <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
        <button onclick="openAddCarModal()" class="inline-flex items-center gap-1 px-2.5 sm:px-3.5 py-1.5 sm:py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-[11px] sm:text-xs font-semibold rounded-lg sm:rounded-xl shadow-sm transition">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>নতুন গাড়ি</span>
        </button>
        <button onclick="quickPrintMonthlyReport()" class="inline-flex items-center gap-1 px-2.5 sm:px-3.5 py-1.5 sm:py-2 bg-slate-800 hover:bg-slate-900 text-white text-[11px] sm:text-xs font-semibold rounded-lg sm:rounded-xl shadow-sm transition">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
          <span class="hidden xs:inline">প্রিন্ট</span>
        </button>
      </div>
    </header>

    <!-- মূল পেজ কনটেন্ট কন্টেইনার (Responsive Content Wrapper) -->
    <div class="p-3 sm:p-5 lg:p-6 space-y-4 sm:space-y-6 max-w-[1600px] w-full mx-auto">

      <!-- ======================================================================
           ১. ড্যাশবোর্ড ওভারভিউ (TAB 1: Dashboard Overview)
           ====================================================================== -->
      <section id="tab-dashboard" class="tab-content space-y-4 sm:space-y-6">
        
        <!-- ৪টি প্রধান হাইলাইট কার্ড (Fluid KPI Cards) -->
        <div class="grid grid-cols-1 xs:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
          
          <!-- ১. মালিক পক্ষের মোট মূলধন -->
          <div class="bg-white p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden flex flex-col justify-between">
            <div>
              <p class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider truncate">মালিকদের মূলধন</p>
              <h3 id="stat-investor-capital" class="text-base sm:text-xl lg:text-2xl font-black text-slate-900 mt-1 tabular-nums break-words">0.000 KWD</h3>
            </div>
            <p class="text-[10px] sm:text-xs text-indigo-600 font-semibold mt-1" id="stat-investor-count">৩ জন অংশীদার মালিক</p>
          </div>

          <!-- ২. কত গাড়ি ঢুকছে ও বের হইছে -->
          <div class="bg-white p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <p class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider truncate">গাড়ি স্টক (ইন / আউট)</p>
              <h3 id="stat-in-stock-count" class="text-base sm:text-xl lg:text-2xl font-black text-slate-900 mt-1 tabular-nums">০ টি স্টকে আছে</h3>
            </div>
            <p class="text-[10px] sm:text-xs text-emerald-600 font-medium mt-1 truncate" id="stat-sold-out-count">০ টি গাড়ি বিক্রি হইছে</p>
          </div>

          <!-- ৩. কিস্তিতে বিক্রি ও চলতি মাসের আদায় -->
          <div class="bg-white p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
            <div>
              <p class="text-[10px] sm:text-[11px] font-bold text-slate-500 uppercase tracking-wider truncate">চলতি মাসের কিস্তি আদায়</p>
              <h3 id="stat-month-collection" class="text-base sm:text-xl lg:text-2xl font-black text-emerald-600 mt-1 tabular-nums break-words">0.000 KWD</h3>
            </div>
            <p class="text-[10px] sm:text-xs text-rose-500 font-medium mt-1 truncate" id="stat-total-due-balance">বকেয়া বাকি: 0.000 KWD</p>
          </div>

          <!-- ৪. মোট নিট লাভ/লোকসান -->
          <div class="bg-white p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
