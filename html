      const tbody = document.getElementById('dashboard-recent-cars');
      const cardsWrapper = document.getElementById('dashboard-recent-cars-cards');
      tbody.innerHTML = '';
      cardsWrapper.innerHTML = '';

      carsData.slice(0, 5).forEach(car => {
        const netProfit = car.status === 'IN_STOCK' ? 0 : car.sellPrice - (car.buyPrice + car.repairCost);

